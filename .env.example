# Copy this file to `.env.local` and fill in the values you have.
# The site runs fine with NONE of these set — payments just fall back to an
# enquiry, and the catalogue comes from src/lib/sample-products.ts.

# --- Site -------------------------------------------------------------------
# Public base URL. Locally you can leave this unset (defaults to localhost).
# In production set it to your real domain, e.g. https://dadofdiamonds.com
NEXT_PUBLIC_SITE_URL=

# --- Stripe (payments) ----------------------------------------------------
# From https://dashboard.stripe.com/apikeys  (use test keys while developing)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create (see README → "Turn on payments")
STRIPE_WEBHOOK_SECRET=

# --- Sanity (CMS, added later) ------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
