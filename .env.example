# Copy this file to `.env.local` and fill in the values you have.
# The site runs fine with NONE of these set — payments just fall back to an
# enquiry, and the catalogue comes from src/lib/sample-products.ts.

# --- Site -------------------------------------------------------------------
# Public base URL. Locally you can leave this unset (defaults to localhost).
# In production set it to your real domain, e.g. https://dadofdiamonds.com
NEXT_PUBLIC_SITE_URL=

# --- Stripe (payments) ----------------------------------------------------
# From https://dashboard.stripe.com/apikeys  (use test keys while developing)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create (see README → "Turn on payments")
STRIPE_WEBHOOK_SECRET=

# --- Sanity (CMS — powers /studio and the live catalogue) -----------------
# Create a free project at https://sanity.io/manage — the Project ID is shown
# on the project's dashboard. Until this is set, the site uses sample data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: only needed by `npm run seed` to load the starter
# catalogue. Create at https://sanity.io/manage → API → Tokens (Editor role).
SANITY_API_WRITE_TOKEN=

# --- Resend (contact form + cart enquiries) --------------------------------
# Free at https://resend.com/api-keys. Until this is set, the contact form
# falls back to opening the visitor's own email app.
RESEND_API_KEY=
# Optional — only once you've verified a sending domain in Resend. Until then
# mail sends from onboarding@resend.dev and only reaches the address your
# Resend account was created with (see README → "Reliable enquiries").
RESEND_FROM=
